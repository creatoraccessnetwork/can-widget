 {
  "section": "FAQ",
  "where": "Line under the headline. [text](url) = link",
  "key": "faq.sub",
  "text": "Short and sweet. Anything else, [email our founder](mailto:avi@creatoraccessnetwork.com)."
 },
 {
  "section": "FAQ",
  "where": "Question 1",
  "key": "faq.1.q",
  "text": "Is this a coupon site?"
 },
 {
  "section": "FAQ",
  "where": "Answer 1",
  "key": "faq.1.a",
  "text": "No. The rates aren't public. They're pre-negotiated for members, and partners give their best rate anywhere. Access like this used to take years of relationships."
 },
 {
  "section": "FAQ",
  "where": "Question 2",
  "key": "faq.2.q",
  "text": "Do I have to use every discount?"
 },
 {
  "section": "FAQ",
  "where": "Answer 2",
  "key": "faq.2.a",
  "text": "No. Each one is worth more than $49, so the first one you use covers the year."
 },
 {
  "section": "FAQ",
  "where": "Question 3",
  "key": "faq.3.q",
  "text": "What if the price goes up?"
 },
 {
  "section": "FAQ",
  "where": "Answer 3",
  "key": "faq.3.a",
  "text": "Your rate is locked in for life, even when the price goes up."
 },
 {
  "section": "FAQ",
  "where": "Question 4",
  "key": "faq.4.q",
  "text": "Does CAN discount tools I'm using right now?"
 },
 {
  "section": "FAQ",
  "where": "Answer 4",
  "key": "faq.4.a",
  "text": "No. Vendors don't discount their existing customers. The savings are for your next tool decision, as you build your stack."
 },
 {
  "section": "FAQ",
  "where": "Question 5",
  "key": "faq.5.q",
  "text": "Is CAN an agency?"
 },
 {
  "section": "FAQ",
  "where": "Answer 5",
  "key": "faq.5.a",
  "text": "No. CAN doesn't represent you or take a cut of your income. It's a membership that gets you better rates on what you're buying anyway."
 },
