ft", "padding_desktop": {"top": "0", "right": "0", "bottom": "0", "left": "0"}, "margin_desktop": {"top": "0", "right": "0", "bottom": "0", "left": "0"}, "make_flush": "true", "make_block": "true", "hide_on_mobile": "false", "mobile_text_align": "left", "padding_mobile": {"top": "0", "right": "0", "bottom": "0", "left": "0"}, "margin_mobile": {"top": "0", "right": "0", "bottom": "0", "left": "0"}, "animation_type": "none", "animation_direction": "none", "delay": "0", "duration": "0", "reveal_event": "", "reveal_offset": "", "reveal_units": "seconds"}}}}, "1787360000002": {"blocks": {"1787360000002_0": {"settings": {"code": "<div class=\"canv2 two\" id=\"founder\">\n  <div>\n    <p class=\"can-eyebrow\" data-copy=\"founder.eyebrow\">Why CAN exists</p>\n    <h2 class=\"can-h2\" data-copy=\"founder.h2\">Avi spent $12,000+ finding a stack that worked. CAN would have saved him $3,100.</h2>\n    <p data-copy=\"founder.p1\">15 years serving Creators as an agent, producer, and platform exec... then he got laid off and became one. After three failed communities, two fired accountants, and too many attempts at selling courses, products, and software, he had spent $12,000+ on experiments before finding the stack that worked.</p>\n    <p data-copy=\"founder.p2\">CAN shrinks that bill. Most partners give members the best rate they offer anywhere (look for the 🏆) and at just $49/year, it pays for itself fast.</p>\n    <p style=\"margin:8px 0 0\"><a class=\"can-btn\" href=\"mailto:avi@creatoraccessnetwork.com\" data-copy=\"founder.button\">Reach out to Avi</a></p>\n  </div>\n  <div class=\"two-right\">\n    <div class=\"can-card founder\">\n      <img class=\"avatar\" src=\"https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/sites/2148774616/images/420d636-e84b-bcd6-d80-5b5f8ee50f_Avi_Gandhi_Headshot_2026_-_Edited.jpg\" alt=\"Avi Gandhi\">\n      <div><div class=\"can-h3\" data-copy=\"founder.name\">Avi Gandhi</div><div class=\"role\" data-copy=\"founder.role\">Founder, Creator Access Network</div><div class=\"meta\" style=\"margin-top:4px\" data-copy=\"founder.meta\">17 years in the Creator Economy. Former WME agent and Head of Creator Partnerships at Patreon.</div></div>\n    </div>\n    <div class=\"can-card receipt-card\">\n      <div class=\"rc-row\"><span class=\"l\" data-copy=\"founder.row1.l\">Spent on experiments that didn't work</span><span class=\"r\" data-copy=\"founder.row1.r\">$12,000+</span></div>\n      <div class=\"rc-row\"><span class=\"l\" data-copy=\"founder.row2.l\">What CAN discounts would have saved</span><span class=\"r\" data-copy=\"founder.row2.r\">$3,100+</span></div>\n      <div class=\"rc-row\"><span class=\"l\" data-copy=\"founder.row3.l\">CAN membership</span><span class=\"r\" data-copy=\"founder.row3.r\">$49</span></div>\n      <div class=\"rc-row tot\"><span class=\"l\" data-copy=\"founder.row4.l\">Net, first year</span><span class=\"r\" data-copy=\"founder.row4.r\">$3,050+</span></div>\n    </div>\n  </div>\n</div>"}}}}, "1787360000003": {"hidden": "true"}, "1787360000004": {"blocks": {"1787360000004_0": {"settings": {"code": "<div class=\"canv2\" id=\"how\">\n  <div class=\"can-card how-card\">\n  <div class=\"center\"><p class=\"can-eyebrow\" data-copy=\"how.eyebrow\">How it works</p><h2 class=\"can-h2\" data-copy=\"how.h2\">Three steps to a more profitable business.</h2></div>\n  <div class=\"steps\">\n    <div><div class=\"stepn\">1</div><div class=\"can-h3\" data-copy=\"how.step1.h\">Join for $49 a year</div><p data-copy=\"how.step1.p\">Or start free with a starter set of discounts by email. Your rate locks for life when you join.</p></div>\n    <div><div class=\"stepn\">2</div><div class=\"can-h3\" data-copy=\"how.step2.h\">Browse by category</div><p data-copy=\"how.step2.p\">Search by what you're about to buy. 🏆 means the best rate that partner offers anywhere.</p></div>\n    <div><div class=\"stepn\">3</div><div class=\"can-h3\" data-copy=\"how.step3.h\">Redeem as you build</div><p data-copy=\"how.step3.p\">One discount pays for the membership. New discounts land at least monthly.</p></div>\n  </div>\n  <p class=\"oneline\" data-copy=\"how.oneline\">Membership also includes an expert content library and a community of Creators building alongside you.</p>\n  </div>\n</div>"}}}}, "1787360000005": {"blocks": {"1787360000005_0": {"settings": {"code": "<div class=\"canv2\" id=\"faq\" style=\"max-width:820px\">\n  <div class=\"can-card head-card\">\n    <p class=\"can-eyebrow\" style=\"margin-bottom:8px\" data-copy=\"faq.eyebrow\">FAQ</p>\n    <h2 class=\"can-h2\" style=\"margin:0\" data-copy=\"faq.h2\">Questions Creators ask before joining.</h2>\n    <p class=\"meta\" style=\"margin:8px 0 0\" data-copy=\"faq.sub\">Short and sweet. Anything else, <a href=\"mailto:avi@creatoraccessnetwork.com\">email our founder</a>.</p>\n  </div>\n  <div class=\"can-card faq\">\n    <details><summary data-copy=\"faq.1.q\">Is this a coupon site?</summary><p data-copy=\"faq.1.a\">No. The rates aren't public. They're pre-negotiated for members, and partners give their best rate anywhere. Access like this used to take years of relationships.</p></details>\n    <details><summary data-copy=\"faq.2.q\">Do I have to use every discount?</summary><p data-copy=\"faq.2.a\">No. Each one is worth more than $49, so the first one you use covers the year.</p></details>\n    <details><summary data-copy=\"faq.3.q\">What if the price goes up?</summary><p data-copy=\"faq.3.a\">Your rate is locked in for life, even when the price goes up.</p></details>\n    <details><summary data-copy=\"faq.4.q\">Does CAN discount tools I'm using right now?</summary><p data-copy=\"faq.4.a\">No. Vendors don't discount their existing customers. The savings are for your next tool decision, as you build your stack.</p></details>\n    <details><summary data-copy=\"faq.5.q\">Is CAN an agency?</summary><p data-copy=\"faq.5.a\">No. CAN doesn't represent you or take a cut of your income. It's a membership that gets you better rates on what you're buying anyway.</p></details>\n  </div>\n</div>"}}}}, "1787360000000": {"hidden": "true"}, "1787360000007": {"hidden": "true"}, "1787360000001": {"hidden": "true"}, "1787360000006": {"blocks": {"1787360000006_0": {"settings": {"code": "<div class=\"canv2\" id=\"pricing\">\n  <div class=\"center\"><p class=\"can-eyebrow\" data-copy=\"pricing.eyebrow\">Membership</p><h2 class=\"can-h2\" data-copy=\"pricing.h2\">Save thousands for just $49/year.</h2><p data-copy=\"pricing.sub\">It pays for itself.</p></div>\n  <div class=\"can-card price-card\">\n    <div class=\"can-h3\" data-copy=\"pricing.card.title\">CAN Membership</div>\n    <div class=\"price\" style=\"margin:8px 0 16px\"><span data-copy=\"pricing.price\">$49</span><small data-copy=\"pricing.per\">/year</small></div>\n    <ul class=\"checks\">\n      <li><span class=\"chk\">✓</span><span data-copy=\"pricing.b1\"><b class=\"lead\">$36,000+</b> in savings across 50 partners</span></li>\n      <li><span class=\"chk\">✓</span><span data-copy=\"pricing.b2\">Higher affiliate payouts on <b class=\"lead\">20,000+ brands</b> through ShopYourLikes</span></li>\n      <li><span class=\"chk\">✓</span><span data-copy=\"pricing.b3\"><b class=\"lead\">Curated library</b> of educational resources</span></li>\n      <li><span class=\"chk\">✓</span><span data-copy=\"pricing.b4\"><b class=\"lead\">Community</b> of Creators building alongside you</span></li>\n      <li><span class=\"chk\">✓</span><span data-copy=\"pricing.b5\"><b class=\"lead\">New discounts</b> added at least monthly</span></li>\n    </ul>\n    <div class=\"lock\" data-copy=\"pricing.lock\"><b class=\"lead\">Locked in for life:</b> join at $49/year and your rate never goes up, even when the price does.</div>\n    <a class=\"can-btn can-btn--lg can-btn--block\" href=\"https://www.creatoraccessnetwork.com/offers/oyLoKFBu/checkout\" data-copy=\"pricing.button\">Get access for $49</a>\n    <p class=\"fine\" style=\"text-align:center\" data-copy=\"pricing.fine\">Not ready? <a href=\"#starter\">Unlock the Starter Set free</a>.</p>\n  </div>\n</div>\n<!-- Mobile sticky bar hidden 2026-08-24 at Avi's request. To restore it, delete the <style> block below. -->\n<style>@media (max-width:900px){.canv2-sticky{display:none!important}body{padding-bottom:0!important}}</style>\n<div class=\"canv2-sticky\"><span class=\"s-price\">$49/year, locked in</span><a class=\"can-btn\" href=\"#starter\">Unlock the Starter Set</a></div>"}}}}}, "content_for_index": ["", "1787360000008", "1787360000010", "1787360000004", "1787360000002", "1787360000005", "1787360000006", "1787360000003", "1787360000001", "1787360000009", "1787360000000", "1787360000007", "1770324356639", "1780328007575", "1780328034483", "1780328292757", "1780328322578", "1768426131462", "1770053101146", "1770314388672", "1770033836198", "1770033871764", "1770033930120"]}
